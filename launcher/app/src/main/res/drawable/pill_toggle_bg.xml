<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused by TV remote -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Light is ON (Selected) - Warm illuminated glow -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#40FFD166" android:endColor="#1AFFD166" />
            <stroke android:width="1.2dp" android:color="#B3FFD166" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Light is OFF (Unselected) - Dimmed / dark translucent glass -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#08FFFFFF" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
